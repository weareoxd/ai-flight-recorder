# Copy to .env and fill in your values. See README.md > Environment.

LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: set this to have examples/quickstart.py call the real OpenAI API
# instead of LiteLLM's mock_response. Leave unset to keep it fully offline.
OPENAI_API_KEY=sk-...
